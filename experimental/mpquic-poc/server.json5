{
  mode: "peer",
  // wildcard: receives on both 10.10.0.2 and 10.20.0.2 (spec section 8)
  listen: { endpoints: ["quic/0.0.0.0:7447"] },
  scouting: { multicast: { enabled: false } },
  transport: {
    link: {
      tls: {
        listen_certificate: "experimental/mpquic-poc/certs/server.pem",
        listen_private_key: "experimental/mpquic-poc/certs/server-key.pem",
      },
      quic: {
        multipath: {
          enabled: true,
          max_concurrent_paths: 4,
        },
      },
    },
  },
}
